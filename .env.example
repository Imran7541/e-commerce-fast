# Server Environment Configuration
PORT=5050
NODE_ENV=development
APP_URL=http://localhost:5050

# Security Secrets
JWT_SECRET=[[JWT_SECRET_KEY]]
SESSION_SECRET=[[SESSION_SECRET_KEY]]

# Database Configuration (SQLite default; PostgreSQL optional)
DB_CLIENT=sqlite
DB_FILE=data/ecommerce.sqlite

# Courier Integration Credentials
PATHAO_CLIENT_ID=[[PATHAO_CLIENT_ID]]
PATHAO_CLIENT_SECRET=[[PATHAO_CLIENT_SECRET]]
PATHAO_USERNAME=[[PATHAO_USERNAME]]
PATHAO_PASSWORD=[[PATHAO_PASSWORD]]

STEADFAST_API_KEY=[[STEADFAST_API_KEY]]
STEADFAST_SECRET_KEY=[[STEADFAST_SECRET_KEY]]

REDX_API_TOKEN=[[REDX_API_TOKEN]]

# SMS Gateway
SMS_GATEWAY_PROVIDER=greenweb
SMS_API_KEY=[[SMS_API_KEY]]
SMS_SENDER_ID=[[SMS_SENDER_ID]]

# Payment Gateway
SSLCOMMERZ_STORE_ID=[[SSLCOMMERZ_STORE_ID]]
SSLCOMMERZ_STORE_PASS=[[SSLCOMMERZ_STORE_PASS]]
SSLCOMMERZ_IS_LIVE=false
